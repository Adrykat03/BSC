# ============================================
# BSC BackOffice - Variables de Entorno (Ejemplo)
# ============================================
# Copiar este archivo como .env y completar con valores reales.
# cp .env.example .env

# MongoDB
MONGO_ROOT_USER=your_mongo_user
MONGO_ROOT_PASSWORD=your_mongo_password
MONGO_DATABASE=bsc_db

# Mongo Express Basic Auth
ME_BASICAUTH_USERNAME=your_admin_user
ME_BASICAUTH_PASSWORD=your_admin_password

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters
JWT_ISSUER=FlowPulse
JWT_AUDIENCE=FlowPulseApp

# Utilerias Payroll API (proxy de descarga de adjuntos de Alertas Payroll)
# Mantenido por Dennis Suarez. El backend BSC reenvia con este token; nunca lo exponemos al frontend.
UTILERIAS_API_BASE=https://utileriaspayroll.azurewebsites.net/api/Documentos/
UTILERIAS_TOKEN=your_utilerias_token
