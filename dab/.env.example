# Connection string que usa Data API Builder (bsc_dab) para conectarse a SQL Server.
# Copia este archivo a dab/.env y reemplaza los valores con los reales del servidor.
# dab/.env está en .gitignore — NUNCA se commitea.
#
# Notas:
# - Usar un usuario SQL DEDICADO para DAB (no sa, no cuenta de humano).
# - Permisos mínimos: SELECT, INSERT, UPDATE, DELETE sobre Avisos.notificacionesConsolidadas.
# - TrustServerCertificate=True es necesario si SQL usa certificado autofirmado.

SQL_CONN=Server=<host>;Database=<db>;User Id=<user>;Password=<password>;TrustServerCertificate=True;
